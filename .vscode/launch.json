{
  "version": "0.2.0",
  "configurations": [

    {
      "name": "Goldfish: Launch web app",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net8.0/goldfish.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Goldfish: Launch web app (with TS build)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:all",
      "program": "${workspaceFolder}/bin/Debug/net8.0/goldfish.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ],
  "compounds": [
    {
      "name": "Goldfish: Launch + TS Watch",
      "configurations": [
        "Goldfish: Launch web app"
      ],
      "preLaunchTask": "tsc: watch - tsconfig.json"
    }
  ]
}
