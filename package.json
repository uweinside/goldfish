{
  "name": "goldfish",
  "version": "1.0.0",
  "description": "Goldfish - ASP.NET Core 8.0 Razor Pages with TypeScript",
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');const s='node_modules/bootstrap/dist';const d='wwwroot/lib/bootstrap/dist';['js','css'].forEach(t=>{fs.mkdirSync(d+'/'+t,{recursive:true})});fs.copyFileSync(s+'/js/bootstrap.bundle.min.js',d+'/js/bootstrap.bundle.min.js');fs.copyFileSync(s+'/css/bootstrap.min.css',d+'/css/bootstrap.min.css');\"",
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "tsc --watch & dotnet watch run"
  },
  "devDependencies": {
    "bootstrap": "^5.3.8",
    "typescript": "^5.3.0"
  }
}
